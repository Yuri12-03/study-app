<!DOCTYPE html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>学習記録管理アプリ</title>
    <link rel="stylesheet" href="/css/style.css" />
  </head>
  <body>
    <header>
      <div class="header-icon">
        <img src="/images/kame.jpg" alt="カメのアイコン" />
        <span class="header-title">Study-app</span>
      </div>
      <div class="header-greeting">
        <p>
          こんにちは<%= isLoggedIn ? username :
          "ゲスト" %>さん
        </p>
        <% if (isLoggedIn) { %>
          <a href="/logout" class="logout-btn">ログアウト</a>
        <% } %>
      </div>
    </header>
    <div class="main-visual">
      <div class="top-message">
        <h1>Study-app</h1>
        <p>勉強時間を管理します。</p>
        <p>毎日頑張りましょう</p>
      </div>
      <div class="login-btn-wrapper">
        <a class="login-btn" href="/login">login</a>
      </div>
      <div class="join-btn-wrapper">
        <a class="join-btn" href="/join">新規会員登録はこちら</a>
      </div>
    </div>
    <footer class="site-footer">
      <div class="footer-inner">
        <p>Study-app &copy; 2026</p>
        <p>学習記録を毎日の習慣に。</p>
        <div class="footer-links">
          <a href="/home">トップ</a>
          <a href="/login">ログイン</a>
        </div>
      </div>
    </footer>
  </body>
</html>
